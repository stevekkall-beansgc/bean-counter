{
  "schema": "ledger-math-oracle/1",
  "source": "detailed-design \u00a7\u00a77,24,26; independently reviewed document arithmetic",
  "rounding": "exact rationals; final ties away from zero",
  "allocation": "largest remainder, magnitude allocation then sign restoration; stable ascending tie keys",
  "vectors": [
    {
      "name": "first_slice",
      "expression": "base 100; discount = -round(100 * 20/100); total 80",
      "expected": [
        100,
        -20,
        80
      ]
    },
    {
      "name": "priority",
      "expression": "100 + 20 - round(100 * 20/100)",
