{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ledgerlab:proposed:phase2:1",
  "title": "Proposed Phase 2 story fixture: semantic projection, not production wire records",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "ledgerlab-phase2-proposal/1"
    },
    "status": {
      "const": "proposed"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._/-]{0,127}$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
