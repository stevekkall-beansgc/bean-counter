    },
    "events": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1000,
      "additionalProperties": {
        "$ref": "#/$defs/event"
      }
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "event": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._/-]{0,127}$"
          },
          "received": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,29})$"
          }
        },
        "required": [
          "event",
          "received"
        ]
      },
      "maxItems": 1000,
      "minItems": 1
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/result"
          },
          "maxItems": 1000,
          "minItems": 1
        },
        "journal": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision"
          },
          "maxItems": 1000,
          "minItems": 0
        },
        "state": {
          "$ref": "#/$defs/state"
        }
      },
      "required": [
        "results",
        "journal",
        "state"
      ]
    }
  },
  "required": [
    "schema",
    "status",
    "id",
    "description",
    "config",
    "events",
    "attempts",
    "expected"
