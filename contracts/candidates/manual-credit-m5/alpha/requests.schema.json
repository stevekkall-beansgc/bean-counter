{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bean-counter:alpha:manual-credit-requests:1",
  "title": "Manual credit alpha request shapes",
  "description": "Structural precheck only. Runtime validation also enforces UTF-8 byte bounds, canonical reference ordering, local authority, original producer joins and all retained-state checks.",
  "oneOf": [
    {"$ref": "#/$defs/credit"},
    {"$ref": "#/$defs/status"},
    {"$ref": "#/$defs/read"}
  ],
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 128},
    "scope": {
      "type": "object", "additionalProperties": false, "required": ["store", "scope"],
      "properties": {
        "store": {"type": "string", "minLength": 1},
        "scope": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "minLength": 1}}
      }
    },
    "workRef": {
      "type": "object", "additionalProperties": false, "required": ["kind", "id", "digest"],
      "properties": {"kind": {"const": "workflow-work"}, "id": {"type": "string", "pattern": "^wevent_[0-9a-f]{64}$"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
    },
    "stageRef": {
      "type": "object", "additionalProperties": false, "required": ["kind", "id", "digest"],
      "properties": {"kind": {"const": "workflow-stage-instance"}, "id": {"type": "string", "pattern": "^wstage_[0-9a-f]{64}$"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
    },
    "actionRef": {
      "type": "object", "additionalProperties": false, "required": ["kind", "id", "digest"],
      "properties": {"kind": {"const": "workflow-action"}, "id": {"type": "string", "pattern": "^waction_[0-9a-f]{64}$"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
    },
    "creditRef": {
      "type": "object", "additionalProperties": false, "required": ["kind", "id", "digest"],
      "properties": {"kind": {"const": "billing-manual-credit"}, "id": {"type": "string", "pattern": "^m5r_[0-9a-f]{64}$"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
    },
    "credit": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "customer", "adjustment_id", "workflow_scope", "amount", "reason", "work_ref", "stage_instance_ref", "source_action_refs"],
      "properties": {
        "schema": {"const": "ledger-billing-manual-credit/1"}, "customer": {"$ref": "#/$defs/identifier"},
        "adjustment_id": {"$ref": "#/$defs/identifier"}, "workflow_scope": {"$ref": "#/$defs/scope"},
        "amount": {"type": "object", "additionalProperties": false, "required": ["atoms", "currency", "scale"], "properties": {"atoms": {"type": "string", "pattern": "^-[1-9][0-9]{0,29}$"}, "currency": {"const": "USD"}, "scale": {"const": 18}}},
        "reason": {"type": "string", "minLength": 1}, "work_ref": {"$ref": "#/$defs/workRef"},
        "stage_instance_ref": {"$ref": "#/$defs/stageRef"}, "source_action_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/actionRef"}}
      }
    },
    "status": {
      "type": "object", "additionalProperties": false, "required": ["schema", "customer", "workflow_scope", "adjustment_id"],
      "properties": {"schema": {"const": "ledger-billing-manual-credit-status/1"}, "customer": {"$ref": "#/$defs/identifier"}, "workflow_scope": {"$ref": "#/$defs/scope"}, "adjustment_id": {"$ref": "#/$defs/identifier"}}
    },
    "read": {
      "type": "object", "additionalProperties": false, "required": ["schema", "customer", "workflow_scope", "credit_ref"],
      "properties": {"schema": {"const": "ledger-billing-manual-credit-read/1"}, "customer": {"$ref": "#/$defs/identifier"}, "workflow_scope": {"$ref": "#/$defs/scope"}, "credit_ref": {"$ref": "#/$defs/creditRef"}}
    }
  }
}
