{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PUB-BUILD-01 candidate closed records; semantic/trust checks in amendment",
  "$defs": {
    "BuildSourceInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "recipe",
        "entries"
      ],
      "properties": {
        "schema": {
          "const": "ledger-build-source-inventory/1"
        },
        "recipe": {
          "const": "bean-counter-build-inputs/1"
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8192,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "bytes",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "bytes": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,18})$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "BuildSourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_commit",
        "state",
        "inventory_digest",
        "file_count",
        "total_bytes"
      ],
      "properties": {
        "base_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "state": {
          "enum": [
            "clean_commit",
            "worktree_snapshot"
          ]
        },
        "inventory_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "file_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "total_bytes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        }
      }
    },
    "BuildRecipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_name",
        "package_version",
        "build_profile",
        "target",
        "features",
        "rustc_version",
        "cargo_version",
        "rustflags",
        "cargo_lock_digest",
        "compiler_ref"
      ],
      "properties": {
        "package_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "package_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "build_profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "features": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "rustc_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "cargo_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "rustflags": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "cargo_lock_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "compiler_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "digest"
          ],
          "properties": {
            "kind": {
              "const": "workflow-compiler-descriptor"
            },
            "id": {
              "type": "string",
              "pattern": "^wdoc_[0-9a-f]{64}$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "BuildInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "source",
        "recipe"
      ],
      "properties": {
        "schema": {
          "const": "ledger-workflow-build-inputs/1"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "base_commit",
            "state",
            "inventory_digest",
            "file_count",
            "total_bytes"
          ],
          "properties": {
            "base_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "state": {
              "enum": [
                "clean_commit",
                "worktree_snapshot"
              ]
            },
            "inventory_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "file_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8192
            },
            "total_bytes": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,18})$"
            }
          }
        },
        "recipe": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "package_name",
            "package_version",
            "build_profile",
            "target",
            "features",
            "rustc_version",
            "cargo_version",
            "rustflags",
            "cargo_lock_digest",
            "compiler_ref"
          ],
          "properties": {
            "package_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "package_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "build_profile": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "target": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "features": {
              "type": "array",
              "maxItems": 128,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "rustc_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "cargo_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "rustflags": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "cargo_lock_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "compiler_ref": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "id",
                "digest"
              ],
              "properties": {
                "kind": {
                  "const": "workflow-compiler-descriptor"
                },
                "id": {
                  "type": "string",
                  "pattern": "^wdoc_[0-9a-f]{64}$"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    },
    "BuildManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "build_inputs",
        "executable"
      ],
      "properties": {
        "schema": {
          "const": "ledger-workflow-build-manifest/1"
        },
        "build_inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "source",
            "recipe"
          ],
          "properties": {
            "schema": {
              "const": "ledger-workflow-build-inputs/1"
            },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "base_commit",
                "state",
                "inventory_digest",
                "file_count",
                "total_bytes"
              ],
              "properties": {
                "base_commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "state": {
                  "enum": [
                    "clean_commit",
                    "worktree_snapshot"
                  ]
                },
                "inventory_digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "file_count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 8192
                },
                "total_bytes": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,18})$"
                }
              }
            },
            "recipe": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "package_name",
                "package_version",
                "build_profile",
                "target",
                "features",
                "rustc_version",
                "cargo_version",
                "rustflags",
                "cargo_lock_digest",
                "compiler_ref"
              ],
              "properties": {
                "package_name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "package_version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "build_profile": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "target": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "features": {
                  "type": "array",
                  "maxItems": 128,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                },
                "rustc_version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "cargo_version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "rustflags": {
                  "type": "array",
                  "maxItems": 128,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "cargo_lock_digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "compiler_ref": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "id",
                    "digest"
                  ],
                  "properties": {
                    "kind": {
                      "const": "workflow-compiler-descriptor"
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^wdoc_[0-9a-f]{64}$"
                    },
                    "digest": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    }
                  }
                }
              }
            }
          }
        },
        "executable": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "bytes",
            "observation"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,18})$"
            },
            "observation": {
              "const": "stable-current-executable-file/1"
            }
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/BuildSourceInventory"
    },
    {
      "$ref": "#/$defs/BuildInputs"
    },
    {
      "$ref": "#/$defs/BuildManifest"
    }
  ]
}
